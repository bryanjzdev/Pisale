datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CORREDOR
  ORGANIZADOR
  ADMIN
}

enum RaceStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum RaceCategory {
  RUTA
  TRAIL
  NOCTURNA
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CORREDOR)
  
  accounts      Account[]
  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizations Organization[] @relation("UserOrganizations")
  registrations Registration[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  description String?
  logoUrl     String?
  ownerId     String
  type        String?  @default("PERSONA") // "PERSONA" | "EMPRESA"
  phone       String?
  rfc         String?
  status      String   @default("VERIFIED") // "PENDING" | "VERIFIED"
  createdAt   DateTime @default(now())

  owner       User     @relation("UserOrganizations", fields: [ownerId], references: [id])
  races       Race[]

  @@index([ownerId])
  @@index([status])
}

model Race {
  id             String       @id @default(uuid())
  title          String
  date           DateTime
  location       String
  status         RaceStatus   @default(DRAFT)
  imageUrl       String?
  category       RaceCategory
  organizationId String
  startPoint     String?
  endPoint       String?
  surface        String?
  createdAt      DateTime     @default(now())

  // Kit oficial configurable por el organizador (lista de KitItem en JSON)
  kitItems       Json?

  // Demos comerciales de 3 días (no aparecen en el catálogo público)
  isDemo         Boolean      @default(false)
  demoExpiresAt  DateTime?
  demoToken      String?      @unique

  organization   Organization @relation(fields: [organizationId], references: [id])
  distances      RaceDistance[]

  @@index([organizationId])
  @@index([status, date])
  @@index([isDemo])
}

model RaceDistance {
  id                  String   @id @default(uuid())
  raceId              String
  name                String   // e.g. "10K", "21K"
  distanceMeters      Int
  price               Float
  maxParticipants     Int
  currentParticipants Int      @default(0)

  race                Race           @relation(fields: [raceId], references: [id], onDelete: Cascade)
  registrations       Registration[]

  @@index([raceId])
}

model Registration {
  id                    String             @id @default(uuid())
  userId                String
  raceId                String?
  raceTitle             String?
  distanceName          String?
  raceDistanceId        String?
  status                RegistrationStatus @default(PENDING)
  bibNumber             String?
  amountPaid            Float
  shirtSize             String?
  stripeSessionId       String?            @unique
  stripePaymentIntentId String?
  kitDelivered          Boolean            @default(false)
  kitDeliveredAt        DateTime?
  registeredAt          DateTime           @default(now())

  // Tiempos Oficiales y Cronometraje (Live Timing)
  chipTime              String?
  gunTime               String?
  pace                  String?
  overallRank           Int?
  genderRank            Int?
  categoryRank          Int?
  split5k               String?
  split10k              String?
  split21k              String?
  finishedAt            DateTime?

  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  raceDistance          RaceDistance?      @relation(fields: [raceDistanceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([raceId])
  @@index([status])
  @@index([registeredAt])
  @@index([chipTime])
}
